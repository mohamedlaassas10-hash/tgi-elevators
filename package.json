{
  "name": "tgi-ascenseurs-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:rules": "firebase emulators:exec --only firestore \"npm run test:rules:unit\"",
    "test:rules:unit": "node --test tests/firestore.rules.test.mjs src/lib/firebase/tests/rules.test.ts",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "emulators": "firebase emulators:start --only firestore,auth",
    "deploy:firebase": "firebase deploy --only \"firestore:rules,firestore:indexes\""
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "next": "15.5.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^14.9.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
