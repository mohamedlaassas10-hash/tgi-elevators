rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isActiveUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.actif == true;
    }

    function isDirector() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DIRECTEUR';
    }

    function pasDeSuppressionLogique() {
      return !('deletedAt' in request.resource.data) || request.resource.data.deletedAt == null;
    }

    match /users/{uid} {
      allow read: if isActiveUser() && (request.auth.uid == uid || isDirector());
      allow write: if isDirector();
    }

    match /settings/{document=**} {
      allow read, write: if isDirector();
    }

    match /counters/{id} {
      allow read, write: if false;
    }

    match /{collection}/{document=**} {
      allow read: if isActiveUser()
        && !(collection in ['users', 'settings', 'counters']);

      allow create: if isActiveUser()
        && !(collection in ['users', 'settings', 'counters']);

      allow update: if isActiveUser()
        && !(collection in ['users', 'settings', 'counters'])
        && (!(collection in ['factures', 'paiements', 'recus']) || pasDeSuppressionLogique());

      allow delete: if isActiveUser()
        && !(collection in ['users', 'settings', 'factures', 'paiements', 'recus', 'counters']);
    }
  }
}